## @file
#  Read-only RUYIESP FAT payload from the Android bootloader initrd (Block I/O).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = RuyiInitrdDxe
  FILE_GUID      = 7A3C1E55-9B24-4D08-8F61-2C5DB0A41E37
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = RuyiInitrdDxeEntry

[Sources]
  RuyiInitrdDxe.c

[Packages]
  MdePkg/MdePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  MemoryAllocationLib
  PrintLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiDevicePathProtocolGuid

[Depex]
  TRUE
